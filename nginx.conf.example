# ═══════════════════════════════════════════════════════════
#  РИВЬЕРА ХОЛЛ — пример конфигурации nginx
#  Отдайте этот файл администратору хостинга. Это не готовый
#  конфиг: домен, пути и сертификат нужно подставить свои.
#  Для Apache то же самое уже лежит в .htaccess.
# ═══════════════════════════════════════════════════════════

# http → https
server {
    listen 80;
    server_name riviera-hall.ru www.riviera-hall.ru;
    return 301 https://riviera-hall.ru$request_uri;
}

# www → без www
server {
    listen 443 ssl http2;
    server_name www.riviera-hall.ru;
    ssl_certificate     /etc/letsencrypt/live/riviera-hall.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/riviera-hall.ru/privkey.pem;
    return 301 https://riviera-hall.ru$request_uri;
}

server {
    listen 443 ssl http2;
    server_name riviera-hall.ru;

    root /var/www/riviera-hall;
    index index.html;
    charset utf-8;

    ssl_certificate     /etc/letsencrypt/live/riviera-hall.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/riviera-hall.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    error_page 404 /404.html;

    # ── заголовки безопасности ──
    # HSTS включать только когда сертификат точно работает:
    # откатить у уже зашедших посетителей нельзя.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src https://yandex.ru https://*.yandex.ru; connect-src 'self' https://mc.yandex.ru; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;

    # ── сжатие ──
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types text/plain text/css text/xml application/javascript application/json image/svg+xml;
    # brotli_static on;   # если собран модуль brotli

    # ── кеш ──
    location ~* \.(webp|jpe?g|png|svg|ico|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # CSS и JS подключены с ?v=51 — обновляются поднятием номера в html
    location ~* \.(css|js)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # html всегда свежий, иначе правки не доедут до посетителя
    location ~* \.html$ {
        expires 0;
        add_header Cache-Control "public, max-age=0, must-revalidate";
    }

    # ── служебное наружу не отдаём ──
    location ~ /\.          { deny all; }
    location ~* \.(md|log|bak|old)$ { deny all; }
    location ~ ^/(20 версия|21 версия|рефы|_архив|РИВЬЕРА) { deny all; }
}
