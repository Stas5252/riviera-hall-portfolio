# ═══════════════════════════════════════════════════════════
#  РИВЬЕРА ХОЛЛ — конфигурация Apache
#  Кладётся в корень сайта. Если хостинг на nginx, отдайте
#  администратору файл nginx.conf.example — там то же самое.
# ═══════════════════════════════════════════════════════════

# ── HTTPS и единственный адрес сайта ──────────────────────
# Дубли вида www/без-www и http/https поисковик считает разными
# сайтами и делит между ними вес страницы.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http → https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # www → без www. Если решите наоборот, поменяйте эти две строки местами.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # /index.html → / (тоже дубль)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

# ── заголовки безопасности ────────────────────────────────
<IfModule mod_headers.c>
  # Браузер обязан ходить только по https ближайший год.
  # ВНИМАНИЕ: включать после того, как сертификат точно работает —
  # откатить эту директиву у уже зашедших посетителей нельзя.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Запрет угадывать тип файла по содержимому
  Header always set X-Content-Type-Options "nosniff"

  # Сайт нельзя встроить в чужой фрейм — защита от кликджекинга
  Header always set X-Frame-Options "SAMEORIGIN"

  # На чужие сайты уходит только домен, без полного адреса страницы
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Камера, микрофон и геолокация сайту не нужны — отключаем
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # Content-Security-Policy.
  # Всё своё, кроме виджета Яндекс.Карт во фрейме.
  # 'unsafe-inline' для style нужен из-за атрибутов style= в разметке;
  # убирать его — отдельная работа по выносу инлайновых стилей в классы.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src https://yandex.ru https://*.yandex.ru; connect-src 'self' https://mc.yandex.ru; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ── сжатие ────────────────────────────────────────────────
# Без него style.css отдаётся как 66 КБ вместо ~12 КБ,
# а swiper-bundle.min.js — 154 КБ вместо ~43 КБ.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ── кеш ───────────────────────────────────────────────────
# Картинки, шрифты и библиотеки не меняются — их можно держать год.
# CSS и JS подключены с ?v=51: чтобы посетитель получил новую версию,
# поднимите номер во ВСЕХ html-файлах сразу.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/pdf        "access plus 1 month"
  # html всегда свежий, иначе правки не доедут до посетителя
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

# ── закрываем служебное ───────────────────────────────────
<FilesMatch "^\.|\.(md|json|log|bak|old)$">
  Require all denied
</FilesMatch>

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
